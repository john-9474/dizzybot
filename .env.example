# Docker Compose image and required credentials
DIZZYBOT_VERSION=latest
DISCORD_TOKEN=
LAVALINK_PASSWORD=

# Optional music providers
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_COUNTRY_CODE=GB
APPLE_MUSIC_COUNTRY_CODE=GB
TIDAL_TOKEN=
TIDAL_COUNTRY_CODE=GB

# Bot defaults and deployment-wide limits
DEFAULT_VOLUME=75
IDLE_TIMEOUT_SECONDS=300
STAY_CONNECTED=false
DEFAULT_SEARCH_SOURCE=youtube
PLAYLIST_TRACK_LIMIT=100
QUEUE_TRACK_LIMIT=500
RADIO_STATION_LIMIT=50
ALLOW_PRIVATE_RADIO_STREAMS=false
REPOST_PLAYER_CONTROLS=true
COMMAND_SYNC_GUILD_ID=null

# Process settings
LOG_LEVEL=INFO
LAVALINK_JAVA_OPTIONS=-Xms128m -Xmx1g
